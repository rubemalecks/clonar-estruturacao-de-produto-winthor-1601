# Automaticamente usa Thick quando encontra Oracle Client; caso contrário, tenta Thin.
ORA_MODE=auto
ORACLE_USER=usuario_oracle
ORACLE_PASSWORD=senha_oracle
ORACLE_HOST=servidor
ORACLE_PORT=1521
ORACLE_SERVICE=servico
# Ou ORACLE_DSN=servidor:1521/servico
# Para forçar um modo: ORA_MODE=thin ou ORA_MODE=thick
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19
